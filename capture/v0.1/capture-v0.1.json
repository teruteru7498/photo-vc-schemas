{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "$metadata": {
    "uris": {
      "jsonLdContext": "https://raw.githubusercontent.com/teruteru7498/photo-vc-schemas/9c47f5bf2a76c8611e3881ffc0a6bc6ff5b55a27/capture/v0.1/capture-v0.1.jsonld",
      "jsonSchema": "https://raw.githubusercontent.com/teruteru7498/photo-vc-schemas/main/capture/v0.1/capture-v0.1.json"
    },
    "type": "CaptureCredential",
    "version": "0.1"
  },
  "title": "CaptureCredential v0.1",
  "description": "報道写真の撮影VC(開発版)。capture_record は常に開示するまとめ項目、loc_L1〜loc_L5 は撮影者が1つを選んで開示する積み上げ型の位置。",
  "required": [
    "@context",
    "id",
    "type",
    "issuanceDate",
    "credentialSubject",
    "credentialSchema",
    "credentialStatus",
    "issuer"
  ],
  "properties": {
    "@context": {
      "type": ["string", "array", "object"]
    },
    "id": {
      "type": "string"
    },
    "type": {
      "type": ["string", "array"],
      "items": {
        "type": "string"
      }
    },
    "issuer": {
      "type": ["string", "object"],
      "format": "uri",
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "issuanceDate": {
      "type": "string",
      "format": "date-time"
    },
    "expirationDate": {
      "type": "string",
      "format": "date-time"
    },
    "credentialSchema": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": {
          "type": "string",
          "format": "uri"
        },
        "type": {
          "type": "string"
        }
      }
    },
    "subjectPosition": {
      "type": "string",
      "enum": ["none", "index", "value"]
    },
    "merklizationRootPosition": {
      "type": "string",
      "enum": ["none", "index", "value"]
    },
    "revNonce": {
      "type": "integer"
    },
    "version": {
      "type": "integer"
    },
    "updatable": {
      "type": "boolean"
    },
    "credentialSubject": {
      "type": "object",
      "required": ["id", "capture_record"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "撮影者のDID",
          "type": "string",
          "format": "uri"
        },
        "type": {
          "title": "VCの種類",
          "description": "Issuer Node が発行時に自動で CaptureCredential を入れる",
          "type": "string"
        },
        "capture_record": {
          "title": "まとめ項目",
          "description": "basic_metadata / integrity / photographer_intent をJCS(RFC 8785)で正規化したJSON文字列。中身の形は capture-record-v0.1.schema.json の CaptureRecord。",
          "type": "string"
        },
        "loc_L1": {
          "title": "位置 L1(国)",
          "description": "JCS正規化したJSON文字列。形は capture-record-v0.1.schema.json の $defs/loc_L1。",
          "type": "string"
        },
        "loc_L2": {
          "title": "位置 L2(国+都道府県)",
          "type": "string"
        },
        "loc_L3": {
          "title": "位置 L3(国+都道府県+市区町村)",
          "type": "string"
        },
        "loc_L4": {
          "title": "位置 L4(L3まで+約1kmに丸めた座標)",
          "type": "string"
        },
        "loc_L5": {
          "title": "位置 L5(L4まで+精密な座標)",
          "type": "string"
        }
      }
    }
  }
}
